# Connection string do Postgresa (Neon ustawia ją automatycznie po podłączeniu w Vercel)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Maile z linkiem do zmiany hasła – konto Gmail z „hasłem aplikacji” (16 znaków, bez spacji)
GMAIL_USER=twoj.adres@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Adres aplikacji w linkach z maili (na Vercel można pominąć – użyty zostanie adres produkcyjny)
APP_URL=https://twoja-aplikacja.vercel.app

# Testy lokalne: MAIL_TEST=1 – maile tylko w logu serwera, bez wysyłania
# MAIL_TEST=1

# Szyfrowanie sekretów weryfikacji dwuetapowej w bazie (losowe, min. 32 znaki: `openssl rand -base64 48`)
# AUTH_SECRET=

# Panel admina wymaga weryfikacji dwuetapowej; „optional” wyłącza ten wymóg (tylko lokalne testy)
# ADMIN_MFA=optional

# Logowanie Google (opcjonalne; bez obu zmiennych przycisk jest ukryty)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile na rejestracji i resecie hasła (opcjonalne; bez obu zmiennych wyłączone)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
